# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never get committed, but the template does
.env*
!.env.example

# migrations under drizzle/ ARE committed on purpose — they are the record of
# how production got to its current shape. Do not add /drizzle here.

# typescript
*.tsbuildinfo
next-env.d.ts

# installed agent skills — dependencies, not project files
#
# `npx skills add` writes the skill under /.agents/ and symlinks it into
# /.claude/skills/. A symlink does not survive a clone onto another machine,
# and this repo is deployed to the company PC, so committing either half
# would ship something broken. Reinstall instead — the README names all three
# and where they come from.
#
# The two PROJECT skills are committed and must stay so: everything directly
# inside /.claude/skills/ is ignored, then facet-ui and facet-verify are put
# back. Anything installed later is ignored without editing this file again.
/.agents/
/skills-lock.json
/.claude/skills/*
!/.claude/skills/facet-ui/
!/.claude/skills/facet-verify/

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# database dumps — `npm run backup` writes here by default (BACKUP_DIR moves it).
# A dump holds every row and every password hash. It is exactly as sensitive as
# the database, and must never be committed.
/backups/

# AUDIT 2's capture output — screenshots and manifest, rebuilt any time by
# `node scripts/audit2/capture.mjs` against a seeded database. The script is
# committed; its output is not. `.playwright-cli/` and `.playwright/` are
# playwright-cli's own artifact and workspace folders.
/audit-shots/
# Session 46's copies of the audit's before-shots, kept for A/B comparison.
/audit-shots-before-s46/
/.playwright-cli/
/.playwright/
/audit-server.log
/server-3100.log
