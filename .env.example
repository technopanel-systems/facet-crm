# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- PostgreSQL -----------------------------------------------------------
# These create the database inside the db container on first run. Changing
# them after the volume exists has no effect — remove the volume to reset.
POSTGRES_USER=facet
POSTGRES_PASSWORD=change_me_before_real_users
POSTGRES_DB=facet

# Marks this checkout as a development machine. `scripts/dev-fixtures.ts`
# refuses to run without it (docs/15 §7) — it creates real, loginable accounts.
# Safe to keep here: .dockerignore excludes .env*, so this never reaches the
# image, and docker-compose.yml sets NODE_ENV=production on the container as a
# real environment variable, which process.loadEnvFile cannot override.
NODE_ENV=development

# Used by host-side tooling: `npm run dev` and every db:* script.
# The app container does NOT use this value — docker-compose.yml points the
# container at host "db" instead. Keep this on localhost.
DATABASE_URL=postgresql://facet:change_me_before_real_users@localhost:5432/facet

# --- Backups --------------------------------------------------------------
# Where `npm run backup` writes its dumps. Defaults to ./backups (git-ignored)
# when unset, which is right for a development machine.
#
# On the office PC, point this at the folder the Synology NAS already sweeps —
# that is the whole reason it is configurable, so the same script writes
# locally today and to the NAS-swept folder after deploy with no edit. An
# absolute path or a UNC path both work.
#
# **A dump holds every row and every password hash.** It is exactly as
# sensitive as the database, so the folder needs the same access control the
# database has. No real path belongs in this file.
# BACKUP_DIR=

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Verification fixtures (development only) -----------------------------
# The password for the four @example.test accounts `npm run dev:fixtures`
# creates, and the one `npm run verify:routes` logs in with.
#
# **Development only, and it must stay that way.** These are real, loginable
# accounts; both scripts refuse to run unless NODE_ENV is exactly
# "development" (docs/15 §7). The value belongs HERE rather than in a shell
# command, because dev:fixtures re-applies it on every run — stage 2 lost the
# original and had to reset the hashes by hand (docs/23).
DEV_FIXTURE_PASSWORD=

# --- Bootstrap (one-off) --------------------------------------------------
# Used only by `npm run bootstrap:admin` to create the first super admin.
# Fill in, run the script once, then remove these lines.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
