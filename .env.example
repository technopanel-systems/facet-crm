# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- PostgreSQL -----------------------------------------------------------
# These create the database inside the db container on first run. Changing
# them after the volume exists has no effect — remove the volume to reset.
POSTGRES_USER=facet
POSTGRES_PASSWORD=change_me_before_real_users
POSTGRES_DB=facet

# Used by host-side tooling: `npm run dev` and every db:* script.
# The app container does NOT use this value — docker-compose.yml points the
# container at host "db" instead. Keep this on localhost.
DATABASE_URL=postgresql://facet:change_me_before_real_users@localhost:5432/facet

# --- Auth.js (phase 6, not wired yet) -------------------------------------
# Generate with: npx auth secret
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
